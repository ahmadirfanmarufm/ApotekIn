// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  APOTEKER_PENANGGUNG_JAWAB
  TENAGA_TEKNIS_KEFARMASIAN
  ADMIN_LOGISTIK
  OWNER
}

enum ItemCategory {
  OBAT_OTC
  BAHAN_RACIKAN
  NON_OBAT
}

enum POStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

enum AuditStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockOutReason {
  SALE
  EXPIRED
  DAMAGED
  REFUND
  RETURN_TO_SUPPLIER
  ADJUSTMENT_AUDIT
  OTHER
}

enum StockInReason {
  PURCHASE
  RETURN
  INITIAL_STOCK
  ADJUSTMENT_AUDIT
  OTHER
}

enum NotificationType {
  CRITICAL_STOCK
  EXPIRED_WARNING
  ACTION_RECOMMENDATION
  SYSTEM_INFO
}

enum NotificationPriority {
  HIGH
  MEDIUM
  LOW
}

enum InsightType {
  EXECUTIVE_SUMMARY
  WEEKLY_SUMMARY
  MONTHLY_SUMMARY
  STOCK_PREDICTION
  SUPPLIER_RECOMMENDATION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  phone        String?
  noSIPA       String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLogin    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders       PurchaseOrder[]       @relation("PO_CreatedBy")
  stockOuts            StockOut[]            @relation("StockOut_CreatedBy")
  stockAudits          StockAudit[]          @relation("Audit_ConductedBy")
  stockReceipts        StockReceipt[]        @relation("StockReceipt_CreatedBy")
  stockIns             StockInTransaction[]  @relation("StockIn_CreatedBy")
  stockOutTransactions StockOutTransaction[] @relation("StockOutTxn_CreatedBy")
  notifications        Notification[]

  @@map("users")
}

model Supplier {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String
  address       String?  @db.Text
  onDelivery    Int      @default(0)
  Delivered     Int      @default(0)
  TotalDelivery Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders      PurchaseOrder[]
  stockReceipts       StockReceipt[]
  stockInTransactions StockInTransaction[]

  @@map("suppliers")
}

model Item {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  category    ItemCategory
  unit        String
  minStock    Int          @default(10)
  maxStock    Int          @default(100)
  description String?      @db.Text
  imageUrl    String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  batches                  Batch[]
  purchaseOrderItems       PurchaseOrderItem[]
  stockReceiptItems        StockReceiptItem[]
  stockAuditDetails        StockAuditDetail[]
  stockInTransactions      StockInTransaction[]
  stockOutTransactions     StockOutTransaction[]
  stockInTransactionItems  StockInTransactionItem[]
  stockOutTransactionItems StockOutTransactionItem[]

  @@index([category])
  @@map("items")
}

model Batch {
  id              String   @id @default(uuid())
  batchNumber     String
  itemId          String
  quantity        Int
  initialQuantity Int
  expiryDate      DateTime @db.Date
  buyPrice        Decimal  @db.Decimal(12, 2)
  sellPrice       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item                     Item                      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stockOutItems            StockOutItem[]
  stockAuditDetails        StockAuditDetail[]
  stockInTransactionItems  StockInTransactionItem[]
  stockOutTransactionItems StockOutTransactionItem[]

  @@index([itemId, expiryDate])
  @@map("batches")
}

model PurchaseOrder {
  id                 String    @id @default(uuid())
  poNumber           String    @unique
  supplierId         String
  createdById        String
  status             POStatus  @default(PENDING)
  totalAmount        Decimal   @default(0) @db.Decimal(12, 2)
  expectedDeliveryAt DateTime?
  receivedAt         DateTime?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplier            Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy           User                 @relation("PO_CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items               PurchaseOrderItem[]
  receipts            StockReceipt[]
  stockInTransactions StockInTransaction[]

  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String    @id @default(uuid())
  purchaseOrderId String
  itemId          String
  batchNumber     String?
  quantity        Int
  receivedQty     Int       @default(0)
  expiryDate      DateTime? @db.Date
  unitPrice       Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item              Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stockReceiptItems StockReceiptItem[]

  @@map("purchase_order_items")
}

model StockReceipt {
  id              String   @id @default(uuid())
  receiptNumber   String   @unique
  purchaseOrderId String?
  supplierId      String
  createdById     String
  invoiceNumber   String?
  receivedAt      DateTime @default(now())
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     User               @relation("StockReceipt_CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items         StockReceiptItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id                  String   @id @default(uuid())
  stockReceiptId      String
  purchaseOrderItemId String?
  itemId              String
  batchId             String?
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  stockReceipt      StockReceipt       @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  item              Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([stockReceiptId])
  @@index([itemId])
  @@map("stock_receipt_items")
}

model StockOut {
  id          String         @id @default(uuid())
  referenceNo String         @unique
  createdById String
  reason      StockOutReason @default(SALE)
  totalAmount Decimal        @default(0) @db.Decimal(12, 2)
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy User           @relation("StockOut_CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     StockOutItem[]

  @@index([reason])
  @@index([createdAt])
  @@map("stock_outs")
}

model StockOutItem {
  id         String   @id @default(uuid())
  stockOutId String
  batchId    String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  stockOut StockOut @relation(fields: [stockOutId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("stock_out_items")
}

enum StockBatchType {
  PURCHASE
  RETURN
  INITIAL_STOCK
  ADJUSTMENT
  OTHER
}

model StockInTransaction {
  id            String         @id @default(uuid())
  referenceNo   String         @unique
  supplierId    String?
  createdById   String
  reason        StockInReason
  batchType     StockBatchType @default(PURCHASE)
  totalQuantity Int            @default(0)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier        Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy       User                     @relation("StockIn_CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items           StockInTransactionItem[]
  item            Item?                    @relation(fields: [itemId], references: [id])
  itemId          String?
  purchaseOrder   PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?

  @@index([createdAt])
  @@index([supplierId])
  @@map("stock_in_transactions")
}

model StockInTransactionItem {
  id        String   @id @default(uuid())
  stockInId String
  itemId    String
  batchId   String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  stockIn StockInTransaction @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  item    Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch   Batch              @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([stockInId])
  @@index([itemId])
  @@map("stock_in_transaction_items")
}

model StockOutTransaction {
  id            String         @id @default(uuid())
  referenceNo   String         @unique
  createdById   String
  reason        StockOutReason
  batchType     StockBatchType @default(OTHER)
  totalQuantity Int            @default(0)
  totalAmount   Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdBy User                      @relation("StockOutTxn_CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     StockOutTransactionItem[]
  item      Item?                     @relation(fields: [itemId], references: [id])
  itemId    String?

  @@index([createdAt])
  @@map("stock_out_transactions")
}

model StockOutTransactionItem {
  id         String   @id @default(uuid())
  stockOutId String
  itemId     String
  batchId    String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  stockOut StockOutTransaction @relation(fields: [stockOutId], references: [id], onDelete: Cascade)
  item     Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch    Batch               @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([stockOutId])
  @@index([itemId])
  @@map("stock_out_transaction_items")
}

model StockAudit {
  id            String      @id @default(uuid())
  auditNumber   String      @unique
  conductedById String
  status        AuditStatus @default(IN_PROGRESS)
  notes         String?     @db.Text
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  conductedBy User               @relation("Audit_ConductedBy", fields: [conductedById], references: [id], onDelete: Restrict)
  details     StockAuditDetail[]

  @@map("stock_audits")
}

model StockAuditDetail {
  id            String   @id @default(uuid())
  stockAuditId  String
  batchId       String
  itemId        String
  systemStock   Int
  physicalStock Int
  difference    Int
  unitPrice     Decimal  @default(0) @db.Decimal(12, 2)
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  stockAudit StockAudit @relation(fields: [stockAuditId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("stock_audit_details")
}

model AiInsight {
  id        String      @id @default(uuid())
  type      InsightType
  title     String
  summary   String      @db.Text
  data      Json?
  createdAt DateTime    @default(now())

  @@map("ai_insights")
}

model Notification {
  id          String              @id @default(uuid())
  userId      String
  title       String
  message     String              @db.Text
  type        NotificationType
  priority    NotificationPriority @default(MEDIUM)
  isRead      Boolean             @default(false)
  actionLink  String?
  actionLabel String?
  metadata    Json?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@map("notifications")
}
